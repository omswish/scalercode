import java.util.*;

public class Solution {
    public int[] dNums(int[] A, int B) {
        int n = A.length;
        
        // Edge case: if window size is greater than array size
        if (B > n) {
            return new int[0];
        }

        int[] result = new int[n - B + 1];
        Map<Integer, Integer> counts = new HashMap<>();

        // 1. Process the first window of size B
        for (int i = 0; i < B; i++) {
            counts.put(A[i], counts.getOrDefault(A[i], 0) + 1);
        }
        result[0] = counts.size();

        // 2. Slide the window from index 1 to n-B
        for (int i = 1; i <= n - B; i++) {
            int elementToRemove = A[i - 1];
            int elementToAdd = A[i + B - 1];

            // Remove the outgoing element
            if (counts.get(elementToRemove) == 1) {
                counts.remove(elementToRemove);
            } else {
                counts.put(elementToRemove, counts.get(elementToRemove) - 1);
            }

            // Add the incoming element
            counts.put(elementToAdd, counts.getOrDefault(elementToAdd, 0) + 1);

            // Record distinct elements in the current window
            result[i] = counts.size();
        }

        return result;
    }
}

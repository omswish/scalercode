/**
 * Definition for singly-linked list.
 * class ListNode {
 * public int val;
 * public ListNode next;
 * ListNode(int x) { val = x; next = null; }
 * }
 */
public class Solution {
    public ListNode solve(ListNode A, int B, int C) {
        ListNode newNode = new ListNode(B);

        // Case 1: Insert at the head (Position 0 or Empty List)
        if (C == 0 || A == null) {
            newNode.next = A;
            return newNode;
        }

        // Case 2: Insert at position C or at the tail
        ListNode current = A;
        int currentPos = 0;

        // Traverse to find the node at position C-1
        // We stop if we reach the end of the list or the desired position
        while (currentPos < C - 1 && current.next != null) {
            current = current.next;
            currentPos++;
        }

        // Link the new node into the list
        newNode.next = current.next;
        current.next = newNode;

        return A;
    }
}
